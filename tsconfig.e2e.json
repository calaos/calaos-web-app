{
    "compilerOptions": {
        "composite": true,
        "target": "ES2023",
        // DOM alongside node: E2E specs run in node, but `page.evaluate()`
        // callbacks are typechecked against the browser globals they are
        // serialised into (e2e/fixtures.ts installs a history hook).
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "moduleDetection": "force",
        // e2e/fixtures.ts imports app/src/i18n/en.json so the specs assert on
        // the app's own copy rather than a duplicated string.
        "resolveJsonModule": true,
        "isolatedModules": true,
        "types": ["node"],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["playwright.config.ts", "e2e/**/*.ts"]
}
